# SITE_ADDRESS examples:
#   bms.13-233-10-20.sslip.io   -> automatic Let's Encrypt HTTPS (free hostname)
#   bms.example.com             -> automatic HTTPS for your own domain
#   :80                         -> plain HTTP, no certificate
{$SITE_ADDRESS} {
	encode gzip

	# Django: REST API, admin site and its static files.
	@django path /api/* /admin/* /static/*
	handle @django {
		reverse_proxy backend:8000
	}

	# React single-page app: unknown paths fall back to index.html.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
