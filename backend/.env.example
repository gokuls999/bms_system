# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Only needed when DJANGO_DEBUG=False behind a proxy (production)
# CSRF_TRUSTED_ORIGINS=https://your-domain
# DJANGO_SECURE_COOKIES=True

# Database (PostgreSQL). Set DB_ENGINE=sqlite for a zero-setup local fallback.
DB_ENGINE=postgres
DB_NAME=bms
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# JWT lifetimes
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=1

# Frontend origin(s) allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Products at or below this stock level are reported as "low stock"
LOW_STOCK_THRESHOLD=10
TIME_ZONE=Asia/Kolkata
